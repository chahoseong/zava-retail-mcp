# MCP server reader connection; keep administrator settings in .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=zava
POSTGRES_USER=zava_mcp_reader
POSTGRES_PASSWORD=replace-with-a-random-local-password

# The local .env.reader file must remain excluded from Git.
# Changing this file does not change the database role's password.

# Optional server settings: defaults apply only when a variable is absent.
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
# All timeouts are finite, positive seconds; fractions are allowed.
DB_CONNECT_TIMEOUT=10
DB_ACQUIRE_TIMEOUT=5
DB_QUERY_TIMEOUT=10
DB_SHUTDOWN_TIMEOUT=10
# Relative paths are resolved from the project root, not the current directory.
DEV_USER_FILE=config/dev-user.json
