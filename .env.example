# Host-side Python clients connect to this address.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=zava
# Bootstrap administrator only; create a restricted service role in Lab 04.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-local-password

# Copy to .env and replace the password before the first startup.
# Initialization values apply only when the data volume is empty.
# Changing .env later does not change an existing database password.
